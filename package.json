{
  "name": "agent-trace",
  "version": "0.1.0",
  "description": "Chrome DevTools for AI agents — terminal UI for execution tracing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atrace": "./bin/atrace.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hook": {
      "import": "./dist/collector/claude-code/hook-handler.js"
    }
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "atrace": "tsx src/cli.tsx"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "nanoid": "^5.0.9",
    "meow": "^13.2.0",
    "zod": "^3.23.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.12",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai", "agent", "devtools", "tracing", "tui", "terminal",
    "claude", "anthropic", "debugging", "observability"
  ],
  "license": "MIT"
}
